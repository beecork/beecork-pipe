{
  "name": "beecork",
  "version": "1.4.4",
  "description": "Claude Code always-on infrastructure — a phone number, a memory, and an alarm clock",
  "type": "module",
  "bin": {
    "beecork": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "dev:daemon": "tsx src/daemon.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "build:css": "tailwindcss --content src/dashboard/html.ts --minify",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "discord.js": "^14.26.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "eslint": "^10.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "whatsapp",
    "discord",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agent",
    "automation",
    "cron",
    "cli",
    "chatbot",
    "scheduling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/beecork/beecork.git"
  },
  "homepage": "https://beecork.com",
  "bugs": {
    "url": "https://github.com/beecork/beecork/issues"
  },
  "author": "Beecork <hello@beecork.com>",
  "license": "MIT"
}
